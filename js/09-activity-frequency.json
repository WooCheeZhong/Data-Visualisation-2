{
    "$schema":  "https://vega.github.io/schema/vega-lite/v5.json",
    "description":  "Bump chart ranking age groups by the share active at least as often as each frequency step, from once a week to every day.",
    "width":  "container",
    "height":  320,
    "padding":  {
                    "left":  6,
                    "right":  12,
                    "top":  22,
                    "bottom":  6
                },
    "data":  {
                 "url":  "data/activity_by_age.csv",
                 "format":  {
                                "type":  "csv"
                            }
             },
    "transform":  [
                      {
                          "filter":  "indexof([\u00271+ per year\u0027, \u00271+ per month\u0027, \u00271+ per fortnight\u0027], datum.frequency) \u003c 0"
                      },
                      {
                          "calculate":  "datum.frequency === \u00271+ per week\u0027 ? \u0027Once a week\u0027 : replace(datum.frequency, \u0027 per \u0027, \u0027 a \u0027)",
                          "as":  "frequency_label"
                      },
                      {
                          "calculate":  "toNumber(datum.participation_pct)",
                          "as":  "participation_pct"
                      },
                      {
                          "window":  [
                                         {
                                             "op":  "rank",
                                             "as":  "rank"
                                         }
                                     ],
                          "groupby":  [
                                          "frequency"
                                      ],
                          "sort":  [
                                       {
                                           "field":  "participation_pct",
                                           "order":  "descending"
                                       }
                                   ]
                      }
                  ],
    "encoding":  {
                     "x":  {
                               "field":  "frequency_label",
                               "type":  "ordinal",
                               "sort":  [
                                            "Once a week",
                                            "2+ a week",
                                            "3+ a week",
                                            "4+ a week",
                                            "5+ a week",
                                            "6+ a week",
                                            "7+ a week"
                                        ],
                               "scale":  {
                                             "padding":  0.4
                                         },
                               "axis":  {
                                            "title":  "Active at least…",
                                            "titleFontSize":  11,
                                            "titleColor":  "#405148",
                                            "titlePadding":  10,
                                            "labelFontSize":  11,
                                            "labelColor":  "#405148",
                                            "labelAngle":  0,
                                            "labelPadding":  6,
                                            "domain":  true,
                                            "domainColor":  "#87948d",
                                            "domainWidth":  1.2,
                                            "ticks":  true,
                                            "tickColor":  "#87948d",
                                            "tickSize":  4
                                        }
                           },
                     "y":  {
                               "field":  "rank",
                               "type":  "ordinal",
                               "scale":  {
                                             "padding":  0.5
                                         },
                               "axis":  {
                                            "title":  "Rank (1 = highest share active)",
                                            "titleFontSize":  11,
                                            "titleColor":  "#405148",
                                            "titlePadding":  10,
                                            "labelFontSize":  11,
                                            "labelColor":  "#405148",
                                            "labelPadding":  8,
                                            "grid":  true,
                                            "gridColor":  "#eef0ec",
                                            "domain":  false,
                                            "ticks":  false
                                        }
                           }
                 },
    "layer":  [
                  {
                      "params":  [
                                     {
                                         "name":  "pick",
                                         "select":  {
                                                        "type":  "point",
                                                        "fields":  [
                                                                       "age_group"
                                                                   ],
                                                        "on":  "click",
                                                        "clear":  "dblclick"
                                                    },
                                         "value":  [
                                                       {
                                                           "age_group":  "55-64"
                                                       }
                                                   ]
                                     }
                                 ],
                      "mark":  {
                                   "type":  "line",
                                   "strokeWidth":  2.5,
                                   "cursor":  "pointer",
                                   "point":  {
                                                 "filled":  true,
                                                 "size":  60,
                                                 "cursor":  "pointer"
                                             }
                               },
                      "encoding":  {
                                       "color":  {
                                                     "condition":  {
                                                                       "param":  "pick",
                                                                       "field":  "age_group",
                                                                       "type":  "nominal",
                                                                       "scale":  {
                                                                                     "domain":  [
                                                                                                    "15-17",
                                                                                                    "18-24",
                                                                                                    "25-34",
                                                                                                    "35-44",
                                                                                                    "45-54",
                                                                                                    "55-64",
                                                                                                    "65+"
                                                                                                ],
                                                                                     "range":  [
                                                                                                   "#332288",
                                                                                                   "#33bbee",
                                                                                                   "#9b59b6",
                                                                                                   "#e07bb5",
                                                                                                   "#8b5a2b",
                                                                                                   "#b7791f",
                                                                                                   "#1b1b1b"
                                                                                               ]
                                                                                 },
                                                                       "legend":  null
                                                                   },
                                                     "value":  "#d9dbe8"
                                                 },
                                       "detail":  {
                                                      "field":  "age_group",
                                                      "type":  "nominal"
                                                  },
                                       "tooltip":  [
                                                       {
                                                           "field":  "age_group",
                                                           "type":  "nominal",
                                                           "title":  "Age group"
                                                       },
                                                       {
                                                           "field":  "frequency_label",
                                                           "type":  "nominal",
                                                           "title":  "Active at least"
                                                       },
                                                       {
                                                           "field":  "rank",
                                                           "type":  "quantitative",
                                                           "title":  "Rank (of 7)"
                                                       },
                                                       {
                                                           "field":  "participation_pct",
                                                           "type":  "quantitative",
                                                           "title":  "Share of age group (%)",
                                                           "format":  ".1f"
                                                       }
                                                   ]
                                   }
                  },
                  {
                      "transform":  [
                                        {
                                            "filter":  {
                                                           "param":  "pick",
                                                           "empty":  false
                                                       }
                                        }
                                    ],
                      "mark":  {
                                   "type":  "line",
                                   "strokeWidth":  4,
                                   "point":  {
                                                 "filled":  true,
                                                 "size":  90
                                             }
                               },
                      "encoding":  {
                                       "color":  {
                                                     "field":  "age_group",
                                                     "type":  "nominal",
                                                     "legend":  null
                                                 },
                                       "tooltip":  [
                                                       {
                                                           "field":  "age_group",
                                                           "type":  "nominal",
                                                           "title":  "Age group"
                                                       },
                                                       {
                                                           "field":  "frequency_label",
                                                           "type":  "nominal",
                                                           "title":  "Active at least"
                                                       },
                                                       {
                                                           "field":  "rank",
                                                           "type":  "quantitative",
                                                           "title":  "Rank (of 7)"
                                                       },
                                                       {
                                                           "field":  "participation_pct",
                                                           "type":  "quantitative",
                                                           "title":  "Share of age group (%)",
                                                           "format":  ".1f"
                                                       }
                                                   ]
                                   }
                  },
                  {
                      "transform":  [
                                        {
                                            "filter":  "datum.frequency_label === \u00277+ a week\u0027"
                                        }
                                    ],
                      "mark":  {
                                   "type":  "text",
                                   "align":  "left",
                                   "baseline":  "middle",
                                   "dx":  10,
                                   "fontSize":  11,
                                   "fontWeight":  "bold",
                                   "cursor":  "pointer"
                               },
                      "encoding":  {
                                       "text":  {
                                                    "field":  "age_group"
                                                },
                                       "color":  {
                                                     "condition":  {
                                                                       "param":  "pick",
                                                                       "field":  "age_group",
                                                                       "type":  "nominal",
                                                                       "legend":  null
                                                                   },
                                                     "value":  "#9aa39e"
                                                 }
                                   }
                  },
                  {
                      "data":  {
                                   "values":  [
                                                  {
                                                      "label":  "55-64 rank first from weekly to 5+ a week"
                                                  }
                                              ]
                               },
                      "mark":  {
                                   "type":  "text",
                                   "align":  "left",
                                   "baseline":  "bottom",
                                   "dy":  -12,
                                   "fontSize":  11,
                                   "fontStyle":  "italic",
                                   "color":  "#405148"
                               },
                      "encoding":  {
                                       "x":  {
                                                 "datum":  "Once a week"
                                             },
                                       "y":  {
                                                 "datum":  1
                                             },
                                       "text":  {
                                                    "field":  "label"
                                                }
                                   }
                  },
                  {
                      "data":  {
                                   "values":  [
                                                  {
                                                      "label":  "Teens take first for daily activity"
                                                  }
                                              ]
                               },
                      "mark":  {
                                   "type":  "text",
                                   "align":  "right",
                                   "baseline":  "bottom",
                                   "dy":  -12,
                                   "fontSize":  11,
                                   "fontStyle":  "italic",
                                   "color":  "#405148"
                               },
                      "encoding":  {
                                       "x":  {
                                                 "datum":  "7+ a week"
                                             },
                                       "y":  {
                                                 "datum":  1
                                             },
                                       "text":  {
                                                    "field":  "label"
                                                }
                                   }
                  }
              ],
    "config":  {
                   "font":  "Source Sans 3, Arial, sans-serif",
                   "view":  {
                                "stroke":  null
                            }
               }
}