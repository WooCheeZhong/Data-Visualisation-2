{
    "$schema":  "https://vega.github.io/schema/vega-lite/v5.json",
    "description":  "Dumbbell chart comparing unpaid care rates by age group and gender.",
    "width":  "container",
    "height":  350,
    "padding":  {
                    "left":  0,
                    "right":  18,
                    "top":  8,
                    "bottom":  6
                },
    "layer":  [
                  {
                      "data":  {
                                   "url":  "data/care_by_age_gender.csv",
                                   "format":  {
                                                  "type":  "csv"
                                              }
                               },
                      "mark":  {
                                   "type":  "rule",
                                   "color":  "#d7d9d5",
                                   "strokeWidth":  3
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "men_pct",
                                                 "type":  "quantitative",
                                                 "scale":  {
                                                               "domain":  [
                                                                              0,
                                                                              28
                                                                          ]
                                                           }
                                             },
                                       "x2":  {
                                                  "field":  "women_pct"
                                              },
                                       "y":  {
                                                 "field":  "age_group",
                                                 "type":  "ordinal",
                                                 "sort":  [
                                                              "15-19 years",
                                                              "20-24 years",
                                                              "25-29 years",
                                                              "30-34 years",
                                                              "35-39 years",
                                                              "40-44 years",
                                                              "45-49 years",
                                                              "50-54 years",
                                                              "55-59 years",
                                                              "60-64 years",
                                                              "65-69 years",
                                                              "70-74 years",
                                                              "75-79 years",
                                                              "80-84 years",
                                                              "85 years and over"
                                                          ]
                                             }
                                   }
                  },
                  {
                      "data":  {
                                   "url":  "data/care_by_age_gender.csv",
                                   "format":  {
                                                  "type":  "csv"
                                              }
                               },
                      "transform":  [
                                        {
                                            "fold":  [
                                                         "men_pct",
                                                         "women_pct"
                                                     ],
                                            "as":  [
                                                       "gender_key",
                                                       "percentage"
                                                   ]
                                        },
                                        {
                                            "calculate":  "datum.gender_key === \u0027women_pct\u0027 ? \u0027Women\u0027 : \u0027Men\u0027",
                                            "as":  "gender"
                                        }
                                    ],
                      "mark":  {
                                   "type":  "circle",
                                   "size":  75,
                                   "stroke":  "#ffffff",
                                   "strokeWidth":  1.3
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "percentage",
                                                 "type":  "quantitative",
                                                 "scale":  {
                                                               "domain":  [
                                                                              0,
                                                                              28
                                                                          ]
                                                           }
                                             },
                                       "y":  {
                                                 "field":  "age_group",
                                                 "type":  "ordinal",
                                                 "sort":  [
                                                              "15-19 years",
                                                              "20-24 years",
                                                              "25-29 years",
                                                              "30-34 years",
                                                              "35-39 years",
                                                              "40-44 years",
                                                              "45-49 years",
                                                              "50-54 years",
                                                              "55-59 years",
                                                              "60-64 years",
                                                              "65-69 years",
                                                              "70-74 years",
                                                              "75-79 years",
                                                              "80-84 years",
                                                              "85 years and over"
                                                          ]
                                             },
                                       "color":  {
                                                     "field":  "gender",
                                                     "type":  "nominal",
                                                     "scale":  {
                                                                   "domain":  [
                                                                                  "Women",
                                                                                  "Men"
                                                                              ],
                                                                   "range":  [
                                                                                 "#E6007E",
                                                                                 "#007BFF"
                                                                             ]
                                                               },
                                                     "legend":  {
                                                                    "orient":  "top",
                                                                    "direction":  "horizontal",
                                                                    "title":  null,
                                                                    "labelFontSize":  11,
                                                                    "symbolSize":  90,
                                                                    "offset":  8
                                                                }
                                                 },
                                       "tooltip":  [
                                                       {
                                                           "field":  "age_group",
                                                           "type":  "nominal",
                                                           "title":  "Age group"
                                                       },
                                                       {
                                                           "field":  "gender",
                                                           "type":  "nominal",
                                                           "title":  "Gender"
                                                       },
                                                       {
                                                           "field":  "percentage",
                                                           "type":  "quantitative",
                                                           "title":  "Providing unpaid care (%)",
                                                           "format":  ".1f"
                                                       }
                                                   ]
                                   }
                  },
                  {
                      "data":  {
                                   "url":  "data/care_by_age_gender.csv",
                                   "format":  {
                                                  "type":  "csv"
                                              }
                               },
                      "transform":  [
                                        {
                                            "filter":  "datum.age_group === \u002755-59 years\u0027"
                                        },
                                        {
                                            "calculate":  "\u0027Peak: \u0027 + format(datum.women_pct, \u0027.1f\u0027) + \u0027% of women\u0027",
                                            "as":  "label"
                                        }
                                    ],
                      "mark":  {
                                   "type":  "text",
                                   "align":  "left",
                                   "baseline":  "middle",
                                   "dx":  10,
                                   "fontSize":  10,
                                   "color":  "#405148"
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "women_pct",
                                                 "type":  "quantitative",
                                                 "scale":  {
                                                               "domain":  [
                                                                              0,
                                                                              28
                                                                          ]
                                                           }
                                             },
                                       "y":  {
                                                 "field":  "age_group",
                                                 "type":  "ordinal",
                                                 "sort":  [
                                                              "15-19 years",
                                                              "20-24 years",
                                                              "25-29 years",
                                                              "30-34 years",
                                                              "35-39 years",
                                                              "40-44 years",
                                                              "45-49 years",
                                                              "50-54 years",
                                                              "55-59 years",
                                                              "60-64 years",
                                                              "65-69 years",
                                                              "70-74 years",
                                                              "75-79 years",
                                                              "80-84 years",
                                                              "85 years and over"
                                                          ]
                                             },
                                       "text":  {
                                                    "field":  "label"
                                                }
                                   }
                  },
                  {
                      "data":  {
                                   "url":  "data/care_by_age_gender.csv",
                                   "format":  {
                                                  "type":  "csv"
                                              }
                               },
                      "mark":  {
                                   "type":  "point",
                                   "opacity":  0
                               },
                      "encoding":  {
                                       "x":  {
                                                 "field":  "men_pct",
                                                 "type":  "quantitative",
                                                 "scale":  {
                                                               "domain":  [
                                                                              0,
                                                                              28
                                                                          ]
                                                           },
                                                 "axis":  {
                                                              "title":  "People in the age group providing unpaid care (%)",
                                                              "titleFontSize":  11,
                                                              "titleColor":  "#405148",
                                                              "titlePadding":  10,
                                                              "labelFontSize":  11,
                                                              "labelColor":  "#405148",
                                                              "labelPadding":  6,
                                                              "grid":  true,
                                                              "gridColor":  "#e6e8e4",
                                                              "tickCount":  6,
                                                              "domain":  true,
                                                              "domainColor":  "#87948d",
                                                              "domainWidth":  1.2,
                                                              "ticks":  true,
                                                              "tickColor":  "#87948d",
                                                              "tickSize":  4
                                                          }
                                             },
                                       "y":  {
                                                 "field":  "age_group",
                                                 "type":  "ordinal",
                                                 "sort":  [
                                                              "15-19 years",
                                                              "20-24 years",
                                                              "25-29 years",
                                                              "30-34 years",
                                                              "35-39 years",
                                                              "40-44 years",
                                                              "45-49 years",
                                                              "50-54 years",
                                                              "55-59 years",
                                                              "60-64 years",
                                                              "65-69 years",
                                                              "70-74 years",
                                                              "75-79 years",
                                                              "80-84 years",
                                                              "85 years and over"
                                                          ],
                                                 "axis":  {
                                                              "title":  null,
                                                              "labelFontSize":  11,
                                                              "labelColor":  "#405148",
                                                              "labelPadding":  7,
                                                              "ticks":  false,
                                                              "domain":  false
                                                          }
                                             }
                                   }
                  }
              ],
    "config":  {
                   "font":  "Source Sans 3, Arial, sans-serif",
                   "view":  {
                                "stroke":  null
                            }
               },
    "autosize":  {
                     "type":  "fit-x",
                     "contains":  "padding",
                     "resize":  true
                 }
}