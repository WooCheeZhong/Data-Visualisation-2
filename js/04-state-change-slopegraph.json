                                              },
                                       "color":  {
                                                     "condition":  {
                                                                       "test":  "datum.state === \u0027Australian Capital Territory\u0027",
                                                                       "value":  "#c95d35"
                                                                   },
                                                     "value":  "#a9b3ad"
                                                 }
                                   }
                  },
                  {
                      "transform":  [
                                        {
                                            "filter":  "datum.state !== \u0027Australian Capital Territory\u0027"
                                        }
                                    ],
                      "mark":  {
                                   "type":  "point",
                                   "filled":  true,
                                   "size":  88,
                                   "color":  "#55675e",
                                   "stroke":  "#ffffff",
                                   "strokeWidth":  2
                               },
