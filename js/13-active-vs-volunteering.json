{
    "$schema":  "https://vega.github.io/schema/vega-lite/v5.json",
    "description":  "Scatter plot comparing weekly physical activity with formal volunteering for each state and territory in 2025, split into four groups by the median of each measure.",
    "width":  "container",
    "height":  340,
    "padding":  {
                    "left":  0,
                    "right":  16,
                    "top":  6,
                    "bottom":  6
                },
    "data":  {
                 "url":  "data/activity_by_state.csv",
                 "format":  {
                                "type":  "csv"
                            }
             },
    "transform":  [
                      {
                          "filter":  "datum.year === \u00272025\u0027 \u0026\u0026 datum.frequency === \u0027At least once per week\u0027"
                      },
                      {
                          "lookup":  "state_code",
                          "from":  {
                                       "data":  {
                                                    "url":  "data/state_contribution.csv",
                                                    "format":  {
                                                                   "type":  "csv"
                                                               }
                                                },
                                       "key":  "state_code",
                                       "fields":  [
                                                      "formal_volunteering_pct"
                                                  ]
                                   }
                      },
                      {
                          "calculate":  "toNumber(datum.participation_pct)",
                          "as":  "active_pct"
                      },
                      {
                          "calculate":  "toNumber(datum.formal_volunteering_pct)",
                          "as":  "volunteer_pct"
                      },
                      {
                          "joinaggregate":  [
                                                {
                                                    "op":  "median",
                                                    "field":  "active_pct",
                                                    "as":  "median_active"
                                                },
                                                {
                                                    "op":  "median",
                                                    "field":  "volunteer_pct",
                                                    "as":  "median_volunteer"
                                                }
                                            ]
                      },
                      {
                          "calculate":  "datum.state_code === \u0027NSW\u0027 ? \u0027left\u0027 : datum.state_code === \u0027TAS\u0027 ? \u0027below\u0027 : \u0027right\u0027",
                          "as":  "label_side"
                      },
                      {
                          "calculate":  "datum.label_side === \u0027left\u0027 ? datum.active_pct - 0.25 : datum.label_side === \u0027below\u0027 ? datum.active_pct : datum.active_pct + 0.25",
                          "as":  "label_x"
                      },
                      {
                          "calculate":  "datum.state_code === \u0027NSW\u0027 ? datum.volunteer_pct + 0.15 : datum.state_code === \u0027QLD\u0027 ? datum.volunteer_pct - 0.2 : datum.state_code === \u0027TAS\u0027 ? datum.volunteer_pct - 0.25 : datum.volunteer_pct",
                          "as":  "label_y"
                      }
                  ],
    "layer":  [
                  {
                      "mark":  {
                                   "type":  "rule",
                                   "color":  "#87948d",
                                   "strokeDash":  [
                                                      5,
                                                      4
                                                  ],
                                   "strokeWidth":  1.2
                               },
                      "encoding":  {
                                       "x":  {
